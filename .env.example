# 普通用户在网页连接窗口中临时输入自己的 DeepSeek API Key。
# 仅显式运行真实 smoke test 时才临时设置 DEEPSEEK_API_KEY；不要使用 VITE_* 密钥变量。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
ASSISTANT_PORT=8787

# Public website only. Install Upstash Redis through the Vercel Marketplace;
# Vercel currently injects KV_REST_API_URL / KV_REST_API_TOKEN.
# UPSTASH_REDIS_REST_* remains available for a manually managed Upstash database.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ASSISTANT_VISITOR_SECRET=

# Deterministic local development only. Do not enable in a real deployment.
ASSISTANT_MOCK=0
